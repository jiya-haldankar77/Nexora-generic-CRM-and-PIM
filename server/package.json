{
  "name": "nexora-backend",
  "version": "1.0.0",
  "description": "NEXORA Dynamic Resource Engine & Integration Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --testPathPatterns=tests/ --forceExit --detectOpenHandles",
    "test:unit": "jest --testPathPatterns=agentRbac.test --testPathPatterns=fieldValidator.test --forceExit",
    "test:e2e": "jest --testPathPatterns=e2e.test --forceExit --detectOpenHandles --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.7",
    "supertest": "^7.3.1"
  }
}
